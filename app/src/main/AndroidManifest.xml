<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Rest-timer alert (ROADMAP P1.4). POST_NOTIFICATIONS is a runtime permission
      on API 33+; if it is refused the timer still runs in-app and the alert is
      simply not posted.

      SCHEDULE_EXACT_ALARM is a special permission the user grants in Settings.
      It is requested so a rest can end on time, but the scheduler falls back to
      an inexact alarm when it is not granted rather than failing.
    -->

    <!--
      Workout history is health data, so it must not leave the device through
      the platform's backup or transfer mechanisms.

      allowBackup="false" only covers cloud backup. Device-to-device transfer
      is governed separately by dataExtractionRules, and is fully enabled when
      that file has no <device-transfer> section. Both are excluded there.
      See app/src/main/res/xml/data_extraction_rules.xml
    -->
    <application
        android:name=".AndroidApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AndroidApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
