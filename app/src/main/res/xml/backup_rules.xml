<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for devices running Android 11 (API 30) and lower, which use
  the <full-backup-content> format instead of <data-extraction-rules>.

  Inherited by Android 12+ only if the app targets API 30 or lower; at
  targetSdk 37 the sibling data_extraction_rules.xml is what actually applies.
  Kept in sync anyway so the policy survives a targetSdk regression.

  https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
