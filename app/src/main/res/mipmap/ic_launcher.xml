<?xml version="1.0" encoding="utf-8"?>
<!--
  The app icon (ROADMAP F14).

  `mipmap-anydpi-v26` is the only density bucket needed: minSdk is 26, so every
  supported device understands adaptive icons and no PNG fallbacks are required.
  The `monochrome` layer is what lets Android 13+ theme the icon to match the
  user's wallpaper; without it the launcher falls back to the coloured icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
