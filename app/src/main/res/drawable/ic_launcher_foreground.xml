<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground (ROADMAP F14).

  108x108 viewport, but only the centre 72x72 circle is guaranteed visible: the
  launcher masks the icon to whatever shape the device uses and animates it, so
  content outside that circle gets cropped. Everything here is kept inside it.

  A dumbbell, because the app is a barbell-oriented workout tracker and the mark
  has to read at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M41,50 h26 v8 h-26 z" />

    <!-- Inner plates -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M31,38 h9 v32 h-9 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M68,38 h9 v32 h-9 z" />

    <!-- Outer plates -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,46 h8 v16 h-8 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M80,46 h8 v16 h-8 z" />
</vector>
